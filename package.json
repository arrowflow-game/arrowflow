{
  "name": "arrowflow",
  "version": "1.0.0",
  "private": true,
  "description": "ArrowFlow - 3D Brain Puzzle",
  "scripts": {
    "lint": "eslint js functions --max-warnings 20",
    "build": "node scripts/build-www.js",
    "cap:sync": "npm run build && npx cap sync android",
    "postinstall": "patch-package",
    "test:rules": "firebase emulators:exec --only firestore \"node tools/firestore-rules.test.js\"",
    "test:backup": "firebase emulators:exec --only firestore \"node tools/backup-firestore.test.js\"",
    "backup": "node tools/backup-firestore.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^7.2.0",
    "@capacitor-community/in-app-review": "^7.1.0",
    "@capacitor-firebase/authentication": "7.5.0",
    "@capacitor-firebase/crashlytics": "7.5.0",
    "@capacitor/android": "7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "7.6.8",
    "@capacitor/core": "7.6.8",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/share": "7.0.2",
    "@capacitor/status-bar": "^7.0.6",
    "@capawesome/capacitor-app-update": "^7.2.0",
    "@capgo/native-purchases": "7.19.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^10.9.1",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.29.0",
    "patch-package": "^8.0.1"
  }
}
