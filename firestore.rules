rules_version = '2';

// ArrowFlow global leaderboard - Firestore Security Rules.
// Public read (no auth needed to view rankings), write only by the doc's own
// anonymous-auth uid, with type/range bounds on every field so a tampered
// client (bypassing this app's own JS and hitting Firestore directly) can't
// write garbage/oversized/wrong-type values that would corrupt the
// leaderboard or feed unescaped/malformed data back into other players' UI.
//
// This is a coarse sanity check, NOT real anti-cheat - it blocks obviously
// invalid values (wrong type, absurd magnitude) but cannot tell a genuine
// high score from a plausible-looking faked one, since the client still
// computes and submits its own score with no server-side verification of
// how it was earned. Closing that gap fully needs a server (e.g. a Cloud
// Function that recomputes the score from a verified play log) - out of
// scope for a client-only Firestore backend.
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per player, keyed by their Firebase Anonymous Auth uid.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.highestLevel is int
        && request.resource.data.highestLevel >= 1
        && request.resource.data.highestLevel <= 300
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        // Bound proportionally to highestLevel instead of a flat constant - a
        // player who has only reached level 10 can't legitimately have a score
        // implying all 300 levels cleared. 25650 = the real worst-case single-level
        // score computed from js/game.js's computeScore() (500 base + maxed time/
        // hearts/star bonuses) against the densest real level in js/levels.js
        // (485 paths, level 262/ASCENSION) - still just a coarse sanity bound, not
        // real anti-cheat (see file header), but far tighter for anyone short of
        // the endgame than the old flat 10,000,000 was.
        && request.resource.data.totalScore <= request.resource.data.highestLevel * 25650;
    }

    // One doc per campaign level (1-300), holding the single highest score
    // anyone has ever gotten on that level. Any authenticated (anonymous)
    // player may write, but only a strictly-higher score than what's already
    // stored is accepted - mirrors the transaction js/leaderboard.js's
    // submitLevelScore() already does client-side, enforced again here so a
    // client can't skip that check by writing directly.
    match /levelBests/{levelId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 50000
        // resource is null (not a Resource object with an .exists() method) for a
        // brand-new document - the previous `!resource.exists()` here was invalid
        // Firestore Rules syntax that threw a runtime null-value error on every
        // first-ever write for a level, which Firestore then denies (rules fail
        // closed on error) - confirmed via Rules Playground, this is why levelBests
        // has had zero documents ever written since the 2026-08-19 collection wipe.
        && (resource == null || request.resource.data.score > resource.data.score);
    }

    // Cloud save (2026-09-02) - one doc per Google-linked player, restoring progress
    // on reinstall (see js/cloudsave.js). Unlike players/{uid} and levelBests/{levelId}
    // above, this data is never read by anyone but its own owner (no leaderboard-style
    // public read), so a malformed value here can only ever corrupt that same player's
    // own restore, not another player's view - bounds below cover the handful of
    // fields worth sanity-checking (mirroring players/{uid}'s style) rather than
    // exhaustively validating every field's shape (levelData/ownedGemSkins/etc. are
    // maps/arrays whose contents only this client ever reads back).
    match /saves/{uid} {
      // Read and write MUST be separate rules here. `request.resource` exists only
      // on a write - on a read it is null, so folding the field checks below into a
      // combined `allow read, write` made every read throw a null-value error, which
      // Firestore denies (rules fail closed). That would have silently broken the
      // one thing cloud save exists for: checkForRestore() could never read the doc
      // back after a reinstall, so a restore would always come up empty.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        // Nickname is optional here, unlike players/{uid} above where it is the
        // leaderboard's display name and must exist. Setting one is genuinely
        // skippable (the nickname prompt has a Skip button), and resetAll() drops
        // it entirely, so cloudsave.js's snapshot sends null for it in both cases -
        // an `is string` check alone silently denied every write from any player
        // who had never named themselves, i.e. cloud save quietly not working at
        // all for them.
        && (!('nickname' in request.resource.data)
            || request.resource.data.nickname == null
            || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 20))
        && request.resource.data.currentLevel is int
        && request.resource.data.currentLevel >= 1
        && request.resource.data.currentLevel <= 300
        && request.resource.data.highestUnlocked is int
        && request.resource.data.highestUnlocked >= 1
        && request.resource.data.highestUnlocked <= 300
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= request.resource.data.highestUnlocked * 25650
        && request.resource.data.gems is int && request.resource.data.gems >= 0
        && request.resource.data.paidGems is int && request.resource.data.paidGems >= 0
        && request.resource.data.hints is int && request.resource.data.hints >= 0
        && request.resource.data.paidHints is int && request.resource.data.paidHints >= 0;
    }

    // Purchase-verification ledger (2026-09-02) - one doc per Google Play purchase
    // token, written ONLY by the verifyPurchase Cloud Function (functions/index.js)
    // through the Admin SDK, which bypasses these rules entirely. Clients have no
    // business reading or writing it: it exists so a genuine purchase receipt
    // can't be replayed by a second account, and a client that could edit it
    // could defeat exactly that check.
    match /verifiedPurchases/{purchaseToken} {
      allow read, write: if false;
    }
  }
}
