# Reference/example clips and screenshots used during development, not project assets
*.mp4
ex3.jpg
test/*.jpg

# Build artifacts from tools/generate_campaign.py, not source
tools/__pycache__/
tools/campaign_gen.log
tools/campaign_output.js
tools/*.bak

# Capacitor / Android app wrap (see scripts/build-www.js)
node_modules/
www/
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/captures/
*.jks
*.keystore
*.p12
# Local copy of the real release-signing keystore + password (source for the
# ANDROID_KEYSTORE_BASE64 GitHub secret) - *.p12 above already covered the keystore
# file itself, but not keystore-password.txt/upload-keystore.b64/the PEM exports
# sitting alongside it in this folder. Found unignored (2026-09-02) while pulling this
# release keystore's SHA-1 for Google Sign-In setup - a broad `git add -A`/`git add .`
# would have committed the plaintext signing password to the repo.
/keystore/
# Exception: android/app/debug.keystore is deliberately committed (fixed, non-secret,
# well-known debug-only credentials) so every CI/local debug build shares one stable
# signing fingerprint - see android/app/build.gradle's signingConfigs.debug comment.
!android/app/debug.keystore

# Scratch space used while testing/releasing - built APKs and AABs (hundreds of
# MB), captured video frames, and marketing renders. None of it is source, and a
# single `git add -A` would otherwise put it in the repo's history forever.
# Patterns, not fixed names: these folders get a fresh suffix every release or
# test session (scratch_apk_f818286, release_aab_2026-09-07, frame dumps named
# after a commit), and the two that were named literally here promptly leaked
# back into `git status` the next time one was created (2026-09-07).
scratch_*/
release_aab*/
marketing/
f[0-9][0-9]/

# Firebase emulator output from `npm run test:rules`
*-debug.log
firebase-export-*/

# Firestore exports from `npm run backup` - real player data, never commit it
backups/

# Raw mascot artwork (skins-src/README.md). The originals are large and only
# the converted transparent PNG in icons/mascots/ is what the game loads, so
# the source images stay out of the repo - the README that explains the format
# does not.
skins-src/*
!skins-src/README.md
